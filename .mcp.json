{
  "mcpServers": {
    "savvydfir": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "/opt/SAVVYDFIR-MCP/sift_mcp/server.py"
      ],
      "env": {
        "EVIDENCE_BASE": "/evidence",
        "MOUNT_BASE": "/mnt",
        "OUTPUT_BASE": "/cases",
        "PYTHONPATH": "/opt/SAVVYDFIR-MCP",
        "MCP_TOOL_TIMEOUT": "1800000"
      }
    },
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve"
      ],
      "type": "stdio"
    }
  }
}
